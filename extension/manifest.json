{
  "manifest_version": 3,
  "name": "Coursewise Canvas Bridge (Local Prototype)",
  "version": "0.1.0",
  "key": "",
  "description": "See Canvas course grades and deadlines, and ask your local Coursewise workspace.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["https://canvas.upenn.edu/*", "http://localhost:5173/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Coursewise", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    { "matches": ["https://canvas.upenn.edu/*"], "js": ["content.js", "insights-model.js", "course-health.js", "palette.js", "vendor/libheif-without-unsafe-eval.js", "course-image.js", "insights.js", "chat-format.js", "canvas-app.js"], "css": ["insights.css", "canvas-app.css", "appearance.css"], "run_at": "document_idle" },
    { "matches": ["https://canvas.upenn.edu/*"], "all_frames": true, "match_about_blank": true, "js": ["appearance-frame.js"], "css": ["appearance-frame.css"], "run_at": "document_idle" }
  ]
}
