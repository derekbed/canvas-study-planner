{
  "manifest_version": 3,
  "name": "Coursewise for Canvas",
  "version": "0.1.5",
  "description": "Customize Canvas and view local course deadlines, grades, and announcements.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Coursewise",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "119",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
